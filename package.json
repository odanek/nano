{
  "name": "@nano-ui/workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nano UI library workspace",
  "author": "Ondrej Danek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git:https://github.com/odanek/nano.git"
  },
  "workspaces": [
    "./packages/*",
    "./samples/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "typescript-eslint": "^8.46.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write --list-different .",
    "clean": "npm run clean --w packages/nano",
    "build": "npm run build --w packages/nano",
    "typecheck": "npm run typecheck --w packages/nano"
  }
}
