{
  "name": "@nano-ui/nano",
  "version": "0.1.0",
  "description": "Nano UI library",
  "author": "Ondrej Danek",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./dist/jsx/runtime.d.ts",
        "default": "./dist/jsx/runtime.js"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./dist/jsx/runtime.d.ts",
        "default": "./dist/jsx/runtime.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git:https://github.com/odanek/nano.git"
  },
  "dependencies": {
    "csstype": "^3.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "scripts": {
    "clean": "tsc --build --clean",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  }
}
