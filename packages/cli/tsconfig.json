{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "lib": ["es2023"],
    "target": "es2023",
    "esModuleInterop": true,
    "module": "node16",
    "moduleResolution": "node16",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["./src/**/*.ts"]
}
