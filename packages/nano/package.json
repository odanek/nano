{
  "name": "@nano-ui/nano",
  "version": "0.2.0",
  "description": "Nano UI library",
  "author": "Ondrej Danek",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./dist/jsx/runtime.d.ts",
        "default": "./dist/jsx/runtime.js"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./dist/jsx/runtime.d.ts",
        "default": "./dist/jsx/runtime.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "ui",
    "jsx",
    "virtual-dom",
    "hooks",
    "css-in-js"
  ],
  "homepage": "https://github.com/odanek/nano#readme",
  "bugs": {
    "url": "https://github.com/odanek/nano/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odanek/nano.git",
    "directory": "packages/nano"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "csstype": "^3.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "prepack": "npm run clean && npm run build"
  }
}
