{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "lib": ["es2023", "dom"],
    "target": "es2023",
    "esModuleInterop": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@nano-ui/nano",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"]
}
