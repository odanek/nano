{
  "name": "@nano-ui/workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nano UI library workspace",
  "author": "Ondrej Danek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git:https://github.com/odanek/nano.git"
  },
  "workspaces": [
    "./packages/*",
    "./samples/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "clean": "npm run clean -w packages/nano",
    "build": "npm run build -w packages/nano",
    "typecheck": "npm run typecheck -w packages/nano -w samples/todo",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
